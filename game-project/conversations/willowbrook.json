  "conversations": [
    {
      "id": "willowbrook_guide",
      "startNodeId": "start",
      "nodes": [
        {
          "id": "start",
          "messages": [
            {
              "text": "Welcome to Willowbrook! I\u2019m June. We get lost adventurers, ambitious adventurers, and adventurers who insist they aren\u2019t lost. Which landmarks can I help you find?"
            }
          ],
          "options": [
            {
              "id": "tutors",
              "text": "Where can I learn the skills?",
              "nextNodeId": "tutors"
            },
            {
              "id": "shops",
              "text": "Where are the shops?",
              "nextNodeId": "shops"
            },
            {
              "id": "adventure",
              "text": "What should I explore first?",
              "nextNodeId": "adventure"
            },
            {
              "id": "basics",
              "text": "How do I get started?",
              "nextNodeId": "basics"
            },
            {
              "id": "bye",
              "text": "Thanks. See you around.",
              "nextNodeId": "bye"
            }
          ]
        },
        {
          "id": "tutors",
          "messages": [
            {
              "text": "Nessa teaches fishing at the pond north of the fountain. Rowan teaches woodcutting just down the west road in Willow Wood. Iris and Captain Ash teach ranged and melee combat in the eastern training yard. Sage Lumen teaches magic beside the Lantern Archive in the southeast."
            }
          ],
          "options": [
            {
              "id": "back",
              "text": "Something else...",
              "nextNodeId": "start"
            },
            {
              "id": "bye",
              "text": "I\u2019ll give that a try.",
              "nextNodeId": "bye"
            }
          ]
        },
        {
          "id": "shops",
          "messages": [
            {
              "text": "Mara\u2019s Trail Supplies is northwest of the square; Ember & Iron is northeast. The Copper Kettle is southwest, and Lantern Curios is southeast. Follow the east road to the Bent Bow for bows and arrows. Open the doors and step inside, then choose Trade on the shopkeeper."
            }
          ],
          "options": [
            {
              "id": "back",
              "text": "Something else...",
              "nextNodeId": "start"
            },
            {
              "id": "bye",
              "text": "I\u2019ll give that a try.",
              "nextNodeId": "bye"
            }
          ]
        },
        {
          "id": "adventure",
          "messages": [
            {
              "text": "DazKins beside the square has a job involving an old key. Try the weak field rats at the eastern training yard, then the tougher quarry rats south of the east road. The abandoned watchhouse farther southeast shelters armed outlaws. The western wood has a hidden ruined shrine."
            }
          ],
          "options": [
            {
              "id": "back",
              "text": "Something else...",
              "nextNodeId": "start"
            },
            {
              "id": "bye",
              "text": "I\u2019ll give that a try.",
              "nextNodeId": "bye"
            }
          ]
        },
        {
          "id": "basics",
          "messages": [
            {
              "text": "Your inventory already contains a sword, axe, fishing rod, bow, staff, a few arrows, and some gold. Equip the tool or weapon you want to use. Click to walk, and use an object\u2019s interaction menu to talk, trade, open doors, chop, fish, or attack."
            }
          ],
          "options": [
            {
              "id": "back",
              "text": "Something else...",
              "nextNodeId": "start"
            },
            {
              "id": "bye",
              "text": "I\u2019ll give that a try.",
              "nextNodeId": "bye"
            }
          ]
        },
        {
          "id": "bye",
          "messages": [
            {
              "text": "Safe travels. Willowbrook will be here when you get back."
            }
          ],
          "endConversation": true
        }
      ]
    },
    {
      "id": "woodcutting_tutor",
      "startNodeId": "start",
      "nodes": [
        {
          "id": "start",
          "messages": [
            {
              "text": "Rowan Moss. Trees don\u2019t care for speeches, so I keep mine short. This axe and a little patience built half of Willowbrook."
            }
          ],
          "options": [
            {
              "id": "tool",
              "text": "How do I chop a tree?",
              "nextNodeId": "tool"
            },
            {
              "id": "logs",
              "text": "What happens to the tree and the logs?",
              "nextNodeId": "logs"
            },
            {
              "id": "wood",
              "text": "Where should I explore?",
              "nextNodeId": "wood"
            },
            {
              "id": "bye",
              "text": "Thanks. See you around.",
              "nextNodeId": "bye"
            }
          ]
        },
        {
          "id": "tool",
          "messages": [
            {
              "text": "Equip your Woodcutting Axe from your inventory, then choose Chop on a living tree. Walk up beside it and you\u2019ll keep swinging automatically. Moving away or changing activities stops the work."
            }
          ],
          "options": [
            {
              "id": "back",
              "text": "Something else...",
              "nextNodeId": "start"
            },
            {
              "id": "bye",
              "text": "I\u2019ll give that a try.",
              "nextNodeId": "bye"
            }
          ]
        },
        {
          "id": "logs",
          "messages": [
            {
              "text": "Successful chops put logs in your inventory. A tree eventually becomes a stump, then regrows after a short wait. Leave inventory space for your logs. Mara in the northwest village shop buys them for gold."
            }
          ],
          "options": [
            {
              "id": "back",
              "text": "Something else...",
              "nextNodeId": "start"
            },
            {
              "id": "bye",
              "text": "I\u2019ll give that a try.",
              "nextNodeId": "bye"
            }
          ]
        },
        {
          "id": "wood",
          "messages": [
            {
              "text": "These oaks are a good place to start. Follow the west road, then the winding trail south to the old stone shrine. My lodge just north of us holds the wayfarer chest DazKins keeps asking about."
            }
          ],
          "options": [
            {
              "id": "back",
              "text": "Something else...",
              "nextNodeId": "start"
            },
            {
              "id": "bye",
              "text": "I\u2019ll give that a try.",
              "nextNodeId": "bye"
            }
          ]
        },
        {
          "id": "bye",
          "messages": [
            {
              "text": "Safe travels. Willowbrook will be here when you get back."
            }
          ],
          "endConversation": true
        }
      ]
    },
    {
      "id": "fishing_tutor",
      "startNodeId": "start",
      "nodes": [
        {
          "id": "start",
          "messages": [
            {
              "text": "Nessa Reed, at your service. I\u2019ve caught fish, boots, and one very offended duck. Today we\u2019ll stick to fish."
            }
          ],
          "options": [
            {
              "id": "rod",
              "text": "How do I start fishing?",
              "nextNodeId": "rod"
            },
            {
              "id": "catch",
              "text": "Why am I waiting?",
              "nextNodeId": "catch"
            },
            {
              "id": "sell",
              "text": "What can I do with my catch?",
              "nextNodeId": "sell"
            },
            {
              "id": "bye",
              "text": "Thanks. See you around.",
              "nextNodeId": "bye"
            }
          ]
        },
        {
          "id": "rod",
          "messages": [
            {
              "text": "Equip your Fishing Rod from your inventory. Choose Fish on the rippling fishing spot, and stand on the bank beside it. You\u2019ll cast, wait for a bite, and reel in your catch automatically."
            }
          ],
          "options": [
            {
              "id": "back",
              "text": "Something else...",
              "nextNodeId": "start"
            },
            {
              "id": "bye",
              "text": "I\u2019ll give that a try.",
              "nextNodeId": "bye"
            }
          ]
        },
        {
          "id": "catch",
          "messages": [
            {
              "text": "A catch is a chance, not a guarantee. Keep your rod equipped and leave room in your inventory. Walking away stops fishing; choose Fish again when you\u2019re ready."
            }
          ],
          "options": [
            {
              "id": "back",
              "text": "Something else...",
              "nextNodeId": "start"
            },
            {
              "id": "bye",
              "text": "I\u2019ll give that a try.",
              "nextNodeId": "bye"
            }
          ]
        },
        {
          "id": "sell",
          "messages": [
            {
              "text": "Mara\u2019s Trail Supplies buys raw fish. Trade with her and sell your catches for gold. There\u2019s another fishing pool deep in Willow Wood if you fancy a quieter bank."
            }
          ],
          "options": [
            {
              "id": "back",
              "text": "Something else...",
              "nextNodeId": "start"
            },
            {
              "id": "bye",
              "text": "I\u2019ll give that a try.",
              "nextNodeId": "bye"
