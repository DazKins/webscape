        {
          "id": "bow",
          "messages": [
            {
              "text": "Equip a Wooden Bow and keep arrows in your inventory. Choose Attack on a field rat. You\u2019ll move within bow range, draw, and release automatically. Every shot needs an arrow; if you run out, shooting stops."
            }
