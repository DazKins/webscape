        {
          "id": "range",
          "messages": [
            {
              "text": "The wooden bow has a range of three tiles. Your character approaches when needed. There\u2019s a short draw before the arrow flies; watch the shot resolve before deciding what to do next."
            }
          ],
          "options": [
            {
              "id": "back",
              "text": "Something else...",
              "nextNodeId": "start"
            },
            {
              "id": "bye",
              "text": "I\u2019ll give that a try.",
