        {
          "id": "supplies",
          "messages": [
            {
              "text": "Tamsin sells bows and arrows inside the Bent Bow, just west of this yard. There\u2019s a practice-arrow chest inside too. These field rats are the gentlest opponents around."
            }
          ],
          "options": [
            {
              "id": "back",
              "text": "Something else...",
